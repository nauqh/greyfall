# Copy to .env and fill in. .env is gitignored; THIS FILE IS COMMITTED, so it
# must never hold a real key or secret.

# ---- required everywhere ----

# Private S3 object holding the Tiny Swords pack. `pnpm assets` fetches it
# before dev and build.
TINY_SWORDS_S3=s3://greyfall-assets/tiny-swords/tiny-swords-v1.zip

# ---- required in production, unset locally ----
#
# Locally these stay unset and ~/.aws supplies them. A build host has no
# ~/.aws, so all three must be set there, in the platform (for Vercel,
# Project Settings > Environment Variables) and not in a file.
#
# All three are needed, region included: with no region the SDK fails with
# "Region is missing" before it reaches S3.
#
# Give the deploy its own IAM user scoped to s3:GetObject on this one key.
# Leave these blank or commented here - a filled-in placeholder fails as
# "Invalid character in header content", which names nothing useful.
#
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-1

# ---- optional ----
#
# Prefix for every pack request. Default /tiny-swords, which suits a host
# serving from the root. A Discord Activity is proxied, so it needs:
# NEXT_PUBLIC_ASSET_BASE=/.proxy/tiny-swords
