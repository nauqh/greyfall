# Copy to .env and edit. .env is gitignored; this template is not.

# ---- required ----

# The private S3 object holding the Tiny Swords pack. `pnpm assets` fetches and
# unpacks it into apps/web/public/tiny-swords, and runs automatically before
# dev and build. It does nothing once the pack is unpacked.
TINY_SWORDS_S3=s3://greyfall-assets/tiny-swords/tiny-swords-v1.zip

# ---- AWS ----
#
# Nothing to set locally: credentials and region come from the standard chain,
# so ~/.aws is enough. The three below are for a host that has no ~/.aws, which
# means any deploy. Set them in the platform's environment variables rather
# than in this file.
#
# Region is worth setting explicitly even though it is not strictly required.
# Without it the SDK falls back to a default and lets S3 redirect to the real
# region; that works, but it costs a round trip and leans on behaviour not
# worth depending on.
#
# Give the deploy its own IAM user scoped to s3:GetObject on this one key.
# Build environment variables are readable by anyone with project access, and
# your own keys can almost certainly do more than read one zip.
#
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- optional ----

# Prefix every pack request gets. Default /tiny-swords, which suits a host
# serving the app from the root. A Discord Activity is proxied, so it needs:
#   NEXT_PUBLIC_ASSET_BASE=/.proxy/tiny-swords
# NEXT_PUBLIC_ASSET_BASE=/tiny-swords
